# *.g.dart
# *.freezed.dart

# Símbolos y ofuscación
app.*.symbols
app.*.map.json

# ------------------------------------------------------------
# Android (reglas adicionales en android/.gitignore)
# ------------------------------------------------------------
/android/app/debug
/android/app/profile
/android/app/release

# ------------------------------------------------------------
# iOS (reglas adicionales en ios/.gitignore)
# ------------------------------------------------------------
**/ios/Flutter/.last_build_id
.build/
.swiftpm/

